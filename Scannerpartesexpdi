-- Sliders da GUI de sucesso
local MIN_VAL = 0.5
local MAX_VAL = 5.0

local function createSlider(name, yPos, color)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0.92, 0, 0, 36)
    container.Position = UDim2.new(0.04, 0, yPos, 0)
    container.BackgroundTransparency = 1
    container.Parent = successFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 14)
    label.BackgroundTransparency = 1
    label.Text = name .. ": 1.0x"
    label.TextColor3 = Color3.fromRGB(200, 200, 220)
    label.Font = Enum.Font.Gotham
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 18)
    track.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    track.BorderSizePixel = 0
    track.Parent = container
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0.111, 0, 1, 0)
    fill.BackgroundColor3 = color
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0.111, -8, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.BorderSizePixel = 0
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    return {container = container, label = label, track = track, fill = fill, knob = knob, value = 1.0, name = name}
end

local heightSlider = createSlider("Altura", 0.22, Color3.fromRGB(60, 200, 120))
local widthSlider = createSlider("Largura", 0.35, Color3.fromRGB(255, 170, 0))
local depthSlider = createSlider("Profundidade", 0.48, Color3.fromRGB(200, 60, 200))
local headSlider = createSlider("Cabeça", 0.61, Color3.fromRGB(60, 180, 255))
local armsSlider = createSlider("Braços", 0.74, Color3.fromRGB(255, 100, 150))
local legsSlider = createSlider("Pernas", 0.87, Color3.fromRGB(150, 255, 100))

local function valToPos(val) return (val - MIN_VAL) / (MAX_VAL - MIN_VAL) end
local function posToVal(pos) return MIN_VAL + (MAX_VAL - MIN_VAL) * pos end

local function setSlider(slider, val)
    val = math.clamp(val, MIN_VAL, MAX_VAL)
    slider.value = val
    local pos = valToPos(val)
    slider.fill.Size = UDim2.new(pos, 0, 1, 0)
    slider.knob.Position = UDim2.new(pos, -8, 0.5, -8)
    slider.label.Text = slider.name .. ": " .. string.format("%.2f", val) .. "x"
end

local function setupSliderDrag(slider, onChange)
    local dragging = false
    local function updateFromX(xPos)
        local trackAbsPos = slider.track.AbsolutePosition.X
        local trackAbsSize = slider.track.AbsoluteSize.X
        if trackAbsSize <= 0 then return end
        local relX = math.clamp((xPos - trackAbsPos) / trackAbsSize, 0, 1)
        setSlider(slider, posToVal(relX))
        onChange()
    end
    local function startDrag(input)
        dragging = true
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
    slider.knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
        end
    end)
    slider.track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
end

-- Lógica de scaling
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

local function getScale(name)
    local s = humanoid:FindFirstChild(name)
    if not s then
        s = Instance.new("NumberValue")
        s.Name = name
        s.Value = 1
        s.Parent = humanoid
    end
    return s
end

local heightScale = getScale("BodyHeightScale")
local widthScale = getScale("BodyWidthScale")
local depthScale = getScale("BodyDepthScale")
local headScale = getScale("HeadScale")

local originals = {
    height = heightScale.Value,
    width = widthScale.Value,
    depth = depthScale.Value,
    head = headScale.Value
}

local function applyScale()
    pcall(function()
        heightScale.Value = heightSlider.value
        widthScale.Value = widthSlider.value
        depthScale.Value = depthSlider.value
        headScale.Value = headSlider.value
    end)
end

local function applyNormal()
    pcall(function()
        heightScale.Value = originals.height
        widthScale.Value = originals.width
        depthScale.Value = originals.depth
        headScale.Value = originals.head
    end)
    
    setSlider(heightSlider, 1.0)
    setSlider(widthSlider, 1.0)
    setSlider(depthSlider, 1.0)
    setSlider(headSlider, 1.0)
end

normalBtn.MouseButton1Click:Connect(applyNormal)

setupSliderDrag(heightSlider, applyScale)
setupSliderDrag(widthSlider, applyScale)
setupSliderDrag(depthSlider, applyScale)
setupSliderDrag(headSlider, applyScale)
setupSliderDrag(armsSlider, applyScale)
setupSliderDrag(legsSlider, applyScale)

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    
    heightScale = getScale("BodyHeightScale")
    widthScale = getScale("BodyWidthScale")
    depthScale = getScale("BodyDepthScale")
    headScale = getScale("HeadScale")
    
    originals.height = heightScale.Value
    originals.width = widthScale.Value
    originals.depth = depthScale.Value
    originals.head = headScale.Value
    
    task.wait(0.5)
    applyScale()
end)

-- Scanner
scanBtn.MouseButton1Click:Connect(function()
    scanBtn.Visible = false
    scannerStatus.Text = "Testando NumberValue do Humanoid..."
    scannerStatus.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    task.wait(0.5)
    
    -- Testa mudar os valores
    local testVal = 2.5
    heightScale.Value = testVal
    widthScale.Value = testVal
    depthScale.Value = testVal
    headScale.Value = testVal
    
    scannerStatus.Text = "Aguardando 3 segundos..."
    task.wait(3)
    
    -- Verifica se os valores foram resetados
    if heightScale.Value == testVal then
        -- SUCESSO
        scannerStatus.Text = "✅ Scaling permitido!"
        scannerStatus.TextColor3 = Color3.fromRGB(100, 255, 150)
        
        task.wait(1)
        scannerGui:Destroy()
        successGui.Enabled = true
        
        -- Reseta pra 1x
        applyNormal()
    else
        -- FALHA
        scannerStatus.Text = "❌ Scaling bloqueado!"
        scannerStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        task.wait(1)
        scannerGui:Destroy()
        failGui.Enabled = true
        
        -- Reseta os valores
        heightScale.Value = originals.height
        widthScale.Value = originals.width
        depthScale.Value = originals.depth
        headScale.Value = originals.head
    end
end)
